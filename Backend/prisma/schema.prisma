// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId            String  @id @default(cuid())
  userFirstname     String  
  userLastname      String
  userEmail         String  @unique
  userPassword      String
  userPhone         String 
  userImage         String?
  userRole          String  @default("user") 
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model IceCream {
  iceCreamId       String  @id @default(cuid())
  iceCreamName     String
  iceCreamFlavor   String
  iceCreamPrice    Float
  iceCreamDescription String
  iceCreamImage    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Toppings {
  toppingId        String  @id @default(cuid())
  toppingName      String
  toppingPrice     Float
  toppingDescription String
  toppingImage     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Orders {
  orderId          String  @id @default(cuid())
  userId           String
  iceCreamId       String
  toppingId        String
  orderStatus      String  @default("pending")
  orderTotal       Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
model OrderItems {
  orderItemId      String  @id @default(cuid())
  orderId          String
  iceCreamId       String
  toppingId        String
  itemQuantity     Int
  itemPrice        Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Cart {
  cartId           String  @id @default(cuid())
  userId           String
  iceCreamId       String
  toppingId        String
  itemQuantity     Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Payment {
  paymentId        String  @id @default(cuid())
  orderId          String
  paymentMethod    String
  paymentStatus    String
  paymentAmount    Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model rating {
  ratingId         String  @id @default(cuid())
  userId           String
  iceCreamId       String
  orderId          String
  ratingValue      Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}