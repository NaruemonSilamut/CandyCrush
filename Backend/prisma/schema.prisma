// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId            String  @id @default(cuid())
  userFirstname     String  
  userLastname      String
  userEmail         String  @unique
  userPassword      String
  userPhone         String 
  userImage         String?
  userRole          String  @default("user") 
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders        Order[]
  carts         Cart[]
  ratings       Rating[]
}
//ice cream ต้องมีความสัมพันธ์กับตัว topping เพราะ 1 ice cream มีได้หลาย topping
model IceCream {
  iceCreamId          String   @id @default(cuid())
  iceCreamName        String
  iceCreamPrice       Float
  iceCreamDescription String
  iceCreamImage       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  orders              Order[]
  orderItems          OrderItem[]
  carts               Cart[]
  ratings             Rating[]
  
  topping            Topping[]
  flavors            flavor[]
}

model Topping {
  toppingId          String   @id @default(cuid())
  toppingName        String
  toppingPrice       Float
  toppingDescription String
  toppingImage       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  orders             Order[]
  orderItems         OrderItem[]
  carts              Cart[]

  iceCream           IceCream @relation(fields: [iceCreamId], references: [iceCreamId])
  iceCreamId         String
}

model flavor {
  flavorId          String   @id @default(cuid())
  flavorName        String
  flavorImage       String?

  iceCream          IceCream @relation(fields: [iceCreamId], references: [iceCreamId])
  iceCreamId        String
}

model Order {
  orderId     String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [userId])
  iceCreamId  String
  iceCream    IceCream    @relation(fields: [iceCreamId], references: [iceCreamId])
  toppingId   String
  topping     Topping     @relation(fields: [toppingId], references: [toppingId])
  orderTotal  Float
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  payment     Payment?
  orderItems  OrderItem[]
  ratings     Rating[]
}

model OrderItem {
  orderItemId String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [orderId])
  iceCreamId  String
  iceCream    IceCream  @relation(fields: [iceCreamId], references: [iceCreamId])
  toppingId   String
  topping     Topping   @relation(fields: [toppingId], references: [toppingId])
  itemQuantity Int
  itemPrice   Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Cart {
  cartId       String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [userId])
  iceCreamId   String
  iceCream     IceCream @relation(fields: [iceCreamId], references: [iceCreamId])
  toppingId    String
  topping      Topping  @relation(fields: [toppingId], references: [toppingId])
  itemQuantity Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, iceCreamId, toppingId])
}

model Payment {
  paymentId     String        @id @default(cuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [orderId])
  paymentMethod String
  paymentAmount Float
  paymentStatus String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Rating {
  ratingId    String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [userId])
  iceCreamId  String
  iceCream    IceCream @relation(fields: [iceCreamId], references: [iceCreamId])
  orderId     String
  order       Order    @relation(fields: [orderId], references: [orderId])
  ratingValue Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, orderId])
}
